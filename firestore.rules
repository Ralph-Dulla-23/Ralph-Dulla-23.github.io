rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(uid) {
      return request.auth != null
          && request.auth.uid == uid
          && uid == 'B0p0XBPscBNF4Dchuk1IsOACrvk2';
    }

    match /users/{uid} {
      // Games: public read for owner's documents, owner-only write
      match /games/{id} {
        allow read: if uid == 'B0p0XBPscBNF4Dchuk1IsOACrvk2';
        allow write: if isOwner(uid);
        match /private/{doc} {
          allow read, write: if isOwner(uid);
        }
      }

      // Books and reading sessions: public read for owner's documents, owner-only write
      match /books/{id} {
        allow read: if uid == 'B0p0XBPscBNF4Dchuk1IsOACrvk2';
        allow write: if isOwner(uid);
        match /sessions/{sid} {
          allow read: if uid == 'B0p0XBPscBNF4Dchuk1IsOACrvk2';
          allow write: if isOwner(uid);
        }
        match /private/{doc} {
          allow read, write: if isOwner(uid);
        }
      }
    }
  }
}
