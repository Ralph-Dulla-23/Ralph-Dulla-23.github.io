# Firebase Web App Config
# Copy from Firebase Console: Project Settings > General > Your apps (Web app)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Your Firebase Auth UID (found in Firebase Console > Authentication > Users after creating your account)
VITE_OWNER_UID=

# RAWG API Key (Get a free key at https://rawg.io/apidocs)
VITE_RAWG_API_KEY=
