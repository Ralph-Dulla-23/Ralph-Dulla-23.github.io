# ==============================================================================
# Ralph Dulla Portfolio & Diary Application - Environment Configuration Template
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your own keys:
#   cp .env.example .env
#
# Note: For public portfolio browsing (viewing public library shelves and projects),
# the app gracefully falls back to compiled public data when Firebase is unconfigured.
# Firebase configuration is only required for owner authentication and cloud diary synchronization.
# ==============================================================================

# Firebase Web App Configuration (Required for owner auth and Firestore sync)
# Obtain these from your Firebase Console -> Project Settings -> General -> Your apps -> Web app
VITE_FIREBASE_API_KEY=your-firebase-api-key-here
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-messaging-sender-id
VITE_FIREBASE_APP_ID=1:your-messaging-sender-id:web:your-app-id

# Owner Firebase Authentication UID
# Matches the owner's Firebase Auth User UID permitted to write in firestore.rules
VITE_OWNER_UID=your-firebase-owner-uid-here

# RAWG Video Games Database API Key (Optional)
# Used for game metadata, cover art search, and descriptions in the gaming diary
# Obtain a free API key at https://rawg.io/apidocs
VITE_RAWG_API_KEY=your-rawg-api-key-here

# Steam Web API Integration (Optional)
# Obtain a key at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your-steam-api-key-here
STEAM_ID64=76561198417375364
